# YouTube Data API v3 key (research, analytics, upload quota)
YOUTUBE_API_KEY=
# OAuth2 client for publishing (Google Cloud console, YouTube Data API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# LLM for ideas/scripts: OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional local ollama fallback (used if LLM_API_KEY is empty)
OLLAMA_MODEL=
# Optional media providers
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# Default output dir for generated projects
YTX_OUT_DIR=./project
# Optional SFX source (royalty-free); if unset, SFX are synthesized with ffmpeg or skipped with a warning
FREESOUND_API_KEY=
